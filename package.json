{
    "name": "@illinois-toolkit/ilw-profile-card",
    "description": "One paragraph description of the component.",
    "repository": "github:web-illinois/ilw-profile-card",
    "private": false,
    "license": "MIT",
    "version": "1.1.0",
    "type": "module",
    "files": [
        "src/**",
        "dist/**",
        "builder/**"
    ],
    "exports": {
        ".": {
            "import": "./dist/ilw-profile-card.js",
            "require": "./dist/ilw-profile-card.cjs",
            "default": "./dist/ilw-profile-card.js"
        },
        "./ilw-profile-card.css": {
            "import": "./dist/ilw-profile-card.css"
        }
    },
    "main": "./dist/ilw-profile-card.js",
    "module": "./dist/ilw-profile-card.js",
    "scripts": {
        "dev": "vite",
        "build": "tsc --noEmit && vite build --config vite.transpile.config.ts --emptyOutDir && vite build --config vite.build.config.ts --emptyOutDir",
        "preview": "vite preview",
        "prepack": "npm run build",
        "test:axe": "playwright test",
        "test:axe:github": "playwright test --config playwright.ci.config.ts",
        "test": "vitest run --browser.headless",
        "test:browser": "vitest watch --browser chromium"
    },
    "dependencies": {
        "@illinois-toolkit/ilw-card": "^1.2.4",
        "@illinois-toolkit/ilw-icon": "^1.2.0",
        "lit": "3.1.3"
    },
    "devDependencies": {
        "@illinois-toolkit/ilw-core": "^2.0.0",
        "@playwright/test": "^1.58.2",
        "@vitest/browser": "^4.0.18",
        "@vitest/browser-playwright": "^4.0.18",
        "playwright": "^1.58.2",
        "prettier": "^3.8.1",
        "typescript": "^5.9.3",
        "vite": "7.3.1",
        "vite-plugin-dts": "^4.5.4",
        "vitest-browser-lit": "^1.0.1"
    }
}
